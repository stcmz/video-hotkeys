{
  "name": "video_hotkeys",
  "description": "Enable YouTube-like hotkey experience for video websites.",
  "version": "4.5.4",
  "private": true,
  "author": "imozo studio",
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit -p src/tsconfig.json",
    "prebuild": "npm run clean",
    "build:content": "cross-env NODE_ENV=production webpack",
    "build": "npm-run-all typecheck build:*",
    "prewatch": "npm run clean",
    "watch:content": "cross-env NODE_ENV=development webpack -w",
    "watch": "npm-run-all --parallel watch:*",
    "zip:extension": "rimraf zip && shx cp -r dist zip && cd zip && rimraf manifest-v2.json && bestzip ../extension.zip * && cd .. && rimraf zip",
    "zip:extension-v2": "rimraf zi2 && shx cp -r dist zi2 && cd zi2 && shx mv -f manifest-v2.json manifest.json && bestzip ../extension-v2.zip * && cd .. && rimraf zi2",
    "zip:source": "bestzip source.zip src/* *.json *.ts *.md",
    "zip": "npm-run-all zip:*"
  },
  "overrides": {
    "serialize-javascript": "^7.0.6",
    "fast-uri": "^3.1.5",
    "shell-quote": "^1.10.0",
    "minimatch@3": {
      "brace-expansion": "^1.1.18"
    },
    "minimatch@10": {
      "brace-expansion": "^5.0.9"
    }
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "@types/copy-webpack-plugin": "^10.1.3",
    "@types/node": "^26.1.2",
    "@types/webpack": "^5.28.5",
    "bestzip": "^3.0.1",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "esbuild-loader": "^4.5.0",
    "esbuild-register": "^3.6.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "shx": "^0.4.0",
    "typescript": "^7.0.2",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  }
}
